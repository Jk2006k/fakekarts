{
  "name": "fakekarts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "node node_modules/typescript/bin/tsc && node node_modules/vite/bin/vite.js build",
    "test": "node --test test/*.test.js && node node_modules/typescript/bin/tsc --outDir .check --noEmit false && node --test .check/game/*.test.js",
    "start": "node server.js --production",
    "preview": "npm run start"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
